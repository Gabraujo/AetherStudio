NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173
DOMAIN=localhost

# Use a long random string, for example: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Only this e-mail can access the catalog administration area.
ADMIN_EMAIL=aetherstudio.figures@gmail.com
# Set once to create the initial admin account, then remove it after the first startup.
ADMIN_BOOTSTRAP_PASSWORD=

# Local development uses the Postgres service from docker-compose.yml.
POSTGRES_DB=aether
POSTGRES_USER=aether
POSTGRES_PASSWORD=replace_with_a_long_random_password
DATABASE_URL=postgres://aether:replace_with_a_long_random_password@localhost:5432/aether
DATABASE_SSL=false
DB_POOL_MAX=10

# Mercado Pago > Credenciais de produção/teste and Webhooks.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
